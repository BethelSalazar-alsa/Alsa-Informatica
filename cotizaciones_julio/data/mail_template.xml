<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_cotizacion" model="mail.template">
            <field name="name">Cotización Express - Enviar al Cliente</field>
            <field name="model_id" ref="model_cotizacion_express"/>
            <field name="subject">{{ object.name or 'Cotización' }} - {{ object.partner_id.name or '' }}</field>
            <field name="email_from">{{ object.user_id.email or '' }}</field>
            <field name="email_to">{{ object.partner_id.email or '' }}</field>
            <field name="reply_to">{{ object.reply_to or object.user_id.email or '' }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="report_template_ids" eval="[(4, ref('cotizaciones_express.report_cotizacion_express'))]"/>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; padding: 20px;">
                    <p>Estimado/a <strong t-esc="object.partner_id.name"/>,</p>
                    <p>Adjunto encontrará nuestra cotización <strong t-esc="object.name"/>.</p>
                    <p>Quedamos atentos a cualquier comentario o duda.</p>
                    <br/>
                    <p>Saludos cordiales,</p>
                    <p><strong t-esc="object.user_id.name"/></p>
                </div>
            </field>
        </record>
    </data>
</odoo>
