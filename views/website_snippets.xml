<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_formulario_licencia_snippet" name="Formulario de Licencias">
        <section class="s_website_form pt32 pb32" data-vcss="001" data-snippet="s_website_form">
            <div class="container">
                <form id="licencia_form_main" action="/website/form/" method="post" enctype="multipart/form-data" class="s_website_form" data-model_name="licencia.contpaqi" data-success_page="/contactus-thank-you">
                    <div class="s_website_form_rows row s_col_no_bgcolor">
                        
                        <!-- Campo: Nombre/Serie -->
                        <div class="mb-3 s_website_form_field col-12 o_website_form_required" data-type="char" data-name="name">
                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                <!-- La clase 's_website_form_label' es OBLIGATORIA en el label -->
                                <label class="col-form-label col-sm-4 s_website_form_label" for="licencia_name">
                                    <span class="s_website_form_label_content">Número de Serie</span>
                                    <span class="s_website_form_mark"> *</span>
                                </label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control s_website_form_input" name="name" id="licencia_name" required="1"/>
                                </div>
                            </div>
                        </div>

                        <!-- Campo: Tipo Software -->
                        <div class="mb-3 s_website_form_field col-12" data-type="selection" data-name="software_type">
                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                <label class="col-form-label col-sm-4 s_website_form_label" for="licencia_software_type">
                                    <span class="s_website_form_label_content">Tipo de Software</span>
                                </label>
                                <div class="col-sm-8">
                                    <select class="form-select s_website_form_input" name="software_type" id="licencia_software_type">
                                        <option value="contpaqi">CONTPAQi</option>
                                        <option value="office">Microsoft Office</option>
                                        <option value="antivirus">Antivirus</option>
                                        <option value="otro">Otro</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Campo: Vencimiento -->
                        <div class="mb-3 s_website_form_field col-12" data-type="date" data-name="fecha_vencimiento">
                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                <label class="col-form-label col-sm-4 s_website_form_label" for="licencia_fecha_vencimiento">
                                    <span class="s_website_form_label_content">Vencimiento</span>
                                </label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control s_website_form_input" name="fecha_vencimiento" id="licencia_fecha_vencimiento"/>
                                </div>
                            </div>
                        </div>

                        <!-- Botón Enviar -->
                        <div class="mb-0 col-12 text-center s_website_form_submit" data-name="Submit Button">
                            <div style="width: 200px;" class="s_website_form_label"/>
                            <button type="submit" class="btn btn-primary s_website_form_send">Registrar Licencia</button>
                            <span id="s_website_form_result"></span>
                        </div>
                    </div>
                </form>
            </div>
        </section>
    </template>

    <template id="snippets_inherit_licencia" inherit_id="website.snippets">
        <xpath expr="//snippets" position="inside">
            <div id="snippet_licencias_cat" class="o_panel">
                <div class="o_panel_header">Gestión de Licencias</div>
                <div class="o_panel_body">
                    <t t-snippet="gestion_licencias.s_formulario_licencia_snippet"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
