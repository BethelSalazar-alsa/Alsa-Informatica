<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_form_alsa_licensing" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.alsa.licensing</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Equipos a atender" name="alsa_licensing" invisible="not partner_id">
                    <separator string="Equipos que se atenderán en este ticket"/>
                    <field name="alsa_equipment_ids" nolabel="1" domain="[('partner_id', '=', partner_id)]" context="{'default_partner_id': partner_id}">
                        <list create="1" delete="1">
                            <field name="name" string="Equipo"/>
                            <field name="equipment_type" string="Tipo" width="100px" widget="badge"/>
                            <field name="license_id" string="Licencia" optional="show"/>
                            <button name="action_open_support_details" type="object" string="Información" icon="fa-info-circle"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
