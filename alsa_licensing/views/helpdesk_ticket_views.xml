<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_form_alsa_licensing" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.alsa.licensing</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Licencias y Equipos" name="alsa_licensing" invisible="not partner_id">
                    <separator string="Licencias vigentes"/>
                    <field name="alsa_active_license_ids" readonly="1" nolabel="1">
                        <list create="0" delete="0">
                            <field name="name" width="140px"/>
                            <field name="product_summary"/>
                            <field name="start_date" optional="hide"/>
                            <field name="expiration_date" width="110px"/>
                            <field name="allowed_access_count" width="80px"/>
                        </list>
                    </field>
                    <separator string="Equipos del cliente"/>
                    <field name="alsa_equipment_selection_line_ids" nolabel="1">
                        <list editable="bottom" delete="0" open_form_view="1">
                            <field name="selected" widget="boolean_toggle" width="65px"/>
                            <field name="equipment_id" width="170px" domain="[('partner_id', '=', parent.partner_id)]" context="{'default_partner_id': parent.partner_id}"/>
                            <field name="equipment_type" width="90px" readonly="False"/>
                            <field name="specifications" string="Características" width="230px" optional="show" readonly="False"/>
                            <field name="product_id" optional="hide" readonly="False"/>
                            <field name="license_id" width="150px" optional="show" readonly="False" domain="[('partner_id', '=', parent.partner_id)]"/>
                        </list>
                        <form string="Equipo del ticket">
                            <sheet>
                                <group>
                                    <group>
                                        <field name="selected" widget="boolean_toggle"/>
                                        <field name="equipment_id" domain="[('partner_id', '=', parent.partner_id)]" context="{'default_partner_id': parent.partner_id}"/>
                                        <field name="equipment_type" readonly="False"/>
                                    </group>
                                    <group>
                                        <field name="product_id" readonly="False"/>
                                        <field name="license_id" readonly="False" domain="[('partner_id', '=', parent.partner_id)]"/>
                                    </group>
                                </group>
                                <group string="Características / Especificaciones">
                                    <field name="specifications" widget="html" nolabel="1" readonly="False"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                    <field name="alsa_equipment_ids" invisible="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
