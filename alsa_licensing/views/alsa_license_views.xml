<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_alsa_license_list" model="ir.ui.view">
        <field name="name">alsa.license.list</field>
        <field name="model">alsa.license</field>
        <field name="arch" type="xml">
            <list string="Licencias" decoration-danger="state == 'expired'" decoration-success="state == 'active'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="start_date"/>
                <field name="expiration_date"/>
                <field name="allowed_access_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_alsa_license_form" model="ir.ui.view">
        <field name="name">alsa.license.form</field>
        <field name="model">alsa.license</field>
        <field name="arch" type="xml">
            <form string="Licencia">
                <sheet>
                    <widget name="web_ribbon" text="Expirada" bg_color="text-bg-danger" invisible="state != 'expired'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Código o nombre de licencia"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="allowed_access_count"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="expiration_date"/>
                            <field name="state" widget="badge" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipos" name="equipment">
                            <field name="equipment_ids" context="{'default_partner_id': partner_id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="equipment_type"/>
                                    <field name="product_id"/>
                                    <field name="specifications" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Origen de venta" name="sale_origin">
                            <group>
                                <field name="sale_order_id"/>
                                <field name="sale_order_line_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_alsa_license_search" model="ir.ui.view">
        <field name="name">alsa.license.search</field>
        <field name="model">alsa.license</field>
        <field name="arch" type="xml">
            <search string="Buscar licencias">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter name="active" string="Vigentes" domain="[('state', '=', 'active')]"/>
                <filter name="expired" string="Expiradas" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                <filter name="group_product" string="Producto / Servicio" context="{'group_by': 'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_alsa_license" model="ir.actions.act_window">
        <field name="name">Licencias</field>
        <field name="res_model">alsa.license</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_alsa_license_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <menuitem id="menu_alsa_licensing_root" name="Licencias y Equipos" sequence="35"/>
    <menuitem id="menu_alsa_license" name="Licencias" parent="menu_alsa_licensing_root" action="action_alsa_license" sequence="10"/>
</odoo>
