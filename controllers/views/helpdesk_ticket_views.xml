<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- NUEVA: Vista de Lista para Equipos -->
    <record id="view_licencia_linea_list" model="ir.ui.view">
        <field name="name">licencia.linea.list</field>
        <field name="model">licencia.linea</field>
        <field name="arch" type="xml">
            <list string="Equipos Instalados">
                <field name="nombre_equipo"/>
                <field name="tipo" widget="badge" decoration-info="tipo == 'terminal'" decoration-warning="tipo == 'servidor'"/>
                <field name="caracteristicas"/>
                <field name="licencia_id" string="Serie Relacionada"/>
            </list>
        </field>
    </record>

    <!-- Vista de Lista de Licencias -->
    <record id="view_licencia_contpaqi_list" model="ir.ui.view">
        <field name="name">licencia.contpaqi.list</field>
        <field name="model">licencia.contpaqi</field>
        <field name="arch" type="xml">
            <list decoration-danger="fecha_vencimiento &lt; current_date">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="fecha_vencimiento"/>
                <field name="vendedor_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario de Licencias -->
    <record id="view_licencia_contpaqi_form" model="ir.ui.view">
        <field name="name">licencia.contpaqi.form</field>
        <field name="model">licencia.contpaqi</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Número de Serie / Licencia"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="vendedor_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="fecha_vencimiento"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipos" name="equipos">
                            <field name="linea_ids">
                                <list editable="bottom">
                                    <field name="nombre_equipo"/>
                                    <field name="tipo"/>
                                    <field name="caracteristicas"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Buscador de Licencias -->
    <record id="view_licencia_contpaqi_search" model="ir.ui.view">
        <field name="name">licencia.contpaqi.search</field>
        <field name="model">licencia.contpaqi</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Serie o Licencia"/>
                <field name="partner_id" string="Cliente"/>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_licencia_contpaqi" model="ir.actions.act_window">
        <field name="name">Licencias Contpaqi</field>
        <field name="res_model">licencia.contpaqi</field>
        <field name="view_mode">list,form</field>
    </record>
        <!-- ESTE ES EL BLOQUE QUE FALTA PARA MOSTRAR LAS PESTAÑAS EN HELPDESK -->
    <record id="helpdesk_ticket_view_form_inherit_licencias" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.licencias</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- Pestaña 1: Licencias -->
                <page string="Licencias" name="licencias_soporte">
                    <field name="licencia_ids" context="{'default_partner_id': partner_id}">
                        <list editable="bottom">
                            <field name="name" string="Serie/Licencia"/>
                            <field name="fecha_vencimiento"/>
                            <field name="vendedor_id" widget="many2one_avatar_user"/>
                        </list>
                    </field>
                </page>
                
                <!-- Pestaña 2: Equipos -->
                <page string="Equipos/Instalaciones" name="equipos_soporte">
                    <!-- El dominio filtra equipos cuyo dueño de licencia sea el cliente del ticket -->
                    <field name="equipo_ids" 
                        domain="[('licencia_id.partner_id', 'child_of', partner_id)]"
                        context="{'default_partner_id': partner_id}">
                        <list editable="bottom">
                            <field name="nombre_equipo"/>
                            <field name="tipo"/>
                            <field name="caracteristicas"/>
                            <field name="licencia_id" string="Serie Relacionada"/>
                        </list>
                    </field>
                </page>

            </xpath>
        </field>
    </record>


    <!-- Menús -->
    <menuitem id="menu_licencias_root" name="Licencias" sequence="10"/>
    <menuitem id="menu_licencias_contpaqi_list" name="Todas las Licencias" parent="menu_licencias_root" action="action_licencia_contpaqi" sequence="10"/>
</odoo>
