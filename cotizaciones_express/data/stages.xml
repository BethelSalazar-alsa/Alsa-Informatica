        <record id="stage_draft" model="cotizacion.express.stage">
            <field name="name">Borrador</field>
            <field name="sequence">10</field>
            <field name="state_type">draft</field>
        </record>
        <record id="stage_sent" model="cotizacion.express.stage">
            <field name="name">Enviado al Cliente</field>
            <field name="sequence">20</field>
            <field name="state_type">sent</field>
        </record>
        <record id="stage_confirmed" model="cotizacion.express.stage">
            <field name="name">Confirmado</field>
            <field name="sequence">30</field>
            <field name="state_type">confirmed</field>
        </record>
        <record id="stage_cancelled" model="cotizacion.express.stage">
            <field name="name">Cancelado</field>
            <field name="sequence">40</field>
            <field name="state_type">cancelled</field>
        </record>
    </data>
</odoo>
