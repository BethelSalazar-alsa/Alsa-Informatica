<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formato Carta (US Letter: 216mm x 279mm) -->
    <record id="paperformat_cotizacion_carta" model="report.paperformat">
        <field name="name">Carta (Cotizaciones Express)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">216</field>
        <field name="page_height">279</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <record id="report_cotizacion_express" model="ir.actions.report">
        <field name="name">Cotización Express</field>
        <field name="model">cotizacion.express</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cotizaciones_express.cotizacion_preview_template</field>
        <field name="report_file">cotizaciones_express.cotizacion_preview_template</field>
        <field name="print_report_name">'Cotizacion_' + (object.name or '')</field>
        <field name="paperformat_id" ref="paperformat_cotizacion_carta"/>
    </record>
</odoo>
