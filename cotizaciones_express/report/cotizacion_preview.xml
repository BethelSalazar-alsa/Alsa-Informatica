<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cotizacion_preview_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">

                    <!-- ESTILOS GLOBALES PARA FORZAR TIMES NEW ROMAN Y TAMAÑO DE LETRA EN 11 PT -->
                    <style>
                        * {
                            font-family: 'Times New Roman', Times, serif !important;
                            font-size: 11pt !important;
                        }
                        body, p, span, div, td, th, strong, a, tr, table {
                            font-family: 'Times New Roman', Times, serif !important;
                            font-size: 11pt !important;
                        }
                        .header, .header * {
                            font-family: 'Times New Roman', Times, serif !important;
                            font-size: 11pt !important;
                        }
                        .footer, .footer * {
                            font-family: 'Times New Roman', Times, serif !important;
                            font-size: 11pt !important;
                        }
                        /* Anular restricciones de bootstrap en el reporte */
                        .container, .container-fluid, .article {
                            width: 100% !important;
                            max-width: 100% !important;
                            padding: 0 !important;
                            margin: 0 !important;
                        }
                    </style>

                    <!-- ENCABEZADO -->
                    <div class="header"
                        style="font-family: 'Times New Roman', Times, serif !important; font-size: 11pt !important; color: #1C355E; width: 100% !important; border-bottom: 2px solid #1C355E; padding-bottom: 4px; margin: 0 !important; overflow: hidden;">
                        <!-- Logo a la izquierda -->
                        <div style="float: left; width: 40%; text-align: left; vertical-align: middle;">
                            <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)"
                                style="max-height: 55px; max-width: 100%;" alt="Logo ALSA" />
                            <t t-if="not doc.company_id.logo">
                                <strong style="font-size: 11pt !important; color: #1C355E; letter-spacing: 1px;">ALSA</strong><br />
                                <span style="font-size: 11pt !important; color: #555; text-transform: uppercase;">Informática</span>
                            </t>
                        </div>
                        <!-- Texto a la derecha extrema -->
                        <div style="float: right; width: 55%; text-align: right; line-height: 1.3; color: #333; padding-top: 5px;">
                            <strong style="font-size: 11pt !important; color: #1C355E; display: block; font-weight: bold;">Alsa Informática</strong>
                            <span style="font-size: 11pt !important; display: block; color: #222;">Conmutador: 312 311 23 25</span>
                            <span style="font-size: 11pt !important; display: block; color: #222;">WhatsApp: 312 550 13 53</span>
                        </div>
                    </div>

                    <!-- CUERPO PRINCIPAL -->
                    <div class="page"
                        style="font-family: 'Times New Roman', Times, serif !important; color: #000; font-size: 11pt !important; padding: 0px !important;">

                        <!-- 1. NÚMERO DE COTIZACIÓN EN CUADRITO Y FECHA -->
                        <div style="width: 100%; margin-top: 4px; margin-bottom: 12px; font-size: 11pt !important; color: #000; text-align: right;">
                            <div style="display: inline-block; background-color: #EBF3FC; border: 1.5px solid #C2D6EC; padding: 4px 10px; border-radius: 4px; margin-bottom: 6px;">
                                <span style="font-weight: bold; color: #1C355E; font-size: 11pt !important;">Cotización: <span t-out="doc.name.replace('COT-', '').replace('COT', '').replace('cot-', '').replace('cot', '')" style="font-size: 11pt !important; font-weight: bold;"/></span>
                            </div>
                            <div style="font-size: 11pt !important;">
                                <span t-esc="doc.city or 'Colima'"/>, <span t-esc="doc.state_location or 'Col.'"/>, <t t-if="doc.date">
                                    <t t-esc="doc.date.strftime('%d')"/> de
                                    <t t-set="months" t-value="['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre']"/>
                                    <t t-esc="months[int(doc.date.strftime('%m'))-1]"/> de
                                    <t t-esc="doc.date.strftime('%Y')"/>
                                </t>
                            </div>
                        </div>

                        <!-- 2. DATOS DEL CLIENTE -->
                        <div style="margin-bottom: 8px;">
                            <div style="text-transform: uppercase; font-weight: bold; line-height: 1.35; text-align: left; font-size: 11pt !important;">
                                <span t-if="doc.partner_id.parent_id" t-field="doc.partner_id.parent_id.name"
                                    style="font-size: 11pt !important; display: block; margin-bottom: 2px;" />
                                <span t-else="" t-field="doc.partner_id.name"
                                    style="font-size: 11pt !important; display: block; margin-bottom: 2px;" />
                                <span t-if="doc.partner_id.street"
                                    style="font-weight: normal; font-size: 11pt !important; color: #222; display: block; margin-top: 0; text-transform: none;">
                                    <span t-field="doc.partner_id.street" />
                                    <span t-if="doc.partner_id.street2">, <span t-field="doc.partner_id.street2" /></span>
                                    <span t-if="doc.partner_id.zip">, C.P. <span t-field="doc.partner_id.zip" /></span>
                                </span>
                                <span t-if="doc.partner_id.parent_id or (doc.partner_id.is_company and doc.partner_id.child_ids)"
                                      style="display: block; font-size: 11pt !important; font-weight: normal; margin-top: 3px; text-transform: none;">
                                    AT'N: 
                                    <t t-if="doc.partner_id.parent_id">
                                        <span t-field="doc.partner_id.name" />
                                    </t>
                                    <t t-else="">
                                        <span t-field="doc.partner_id.child_ids[0].name" />
                                    </t>
                                </span>
                                <span style="letter-spacing: 2px; display: block; margin-top: 3px; font-size: 11pt !important;">P R E S E N T E</span>
                            </div>
                        </div>

                        <t t-set="selected_opts" t-value="doc.option_ids.filtered(lambda o: o.selected)"/>
                        <t t-set="opts_to_render" t-value="selected_opts if doc.state == 'confirmed' else doc.option_ids"/>
                        
                        <t t-foreach="opts_to_render" t-as="option">
                            <!-- Nombre de la Opción como título de sección -->
                            <div style="padding: 6px 0 2px 0; font-weight: bold; text-transform: uppercase; font-size: 11pt !important; text-align: left; color: #1C355E; border-bottom: 1.5px solid #1C355E; margin-bottom: 4px; margin-top: 10px; page-break-after: avoid; break-after: avoid;">
                                <span t-field="option.name" style="font-size: 11pt !important;" />
                            </div>
                            <!-- Descripción General de la Opción -->
                            <div t-if="option.description" style="padding: 3px 4px; font-size: 11pt !important; color: #444; line-height: 1.3; margin-bottom: 6px; page-break-after: avoid; break-after: avoid;">
                                <span t-field="option.description" style="font-size: 11pt !important;"/>
                            </div>

                            <!-- TABLA DE PRODUCTOS DE LA OPCIÓN -->
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 4px; table-layout: fixed !important;">
                                <thead>
                                    <tr style="text-transform: uppercase; font-weight: bold; font-size: 11pt !important;">
                                        <th style="width: 8%; border-top: 1.5px solid #000; border-bottom: 1.5px solid #000; border-left: none; border-right: none; padding: 6px 0; text-align: center; font-size: 11pt !important;">CANT.</th>
                                        <th style="width: 64%; border-top: 1.5px solid #000; border-bottom: 1.5px solid #000; border-left: none; border-right: none; padding: 6px 8px; text-align: left; font-size: 11pt !important;">DESCRIPCIÓN</th>
                                        <th style="width: 13%; border-top: 1.5px solid #000; border-bottom: 1.5px solid #000; border-left: none; border-right: none; padding: 6px 10px 6px 0; text-align: right; font-size: 11pt !important;">P. UNITARIO</th>
                                        <th style="width: 15%; border-top: 1.5px solid #000; border-bottom: 1.5px solid #000; border-left: none; border-right: none; padding: 6px 0; text-align: right; font-size: 11pt !important;">IMPORTE</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Filas de Productos -->
                                    <t t-foreach="option.line_ids" t-as="line">
                                        <tr style="border: none; page-break-inside: avoid;">
                                            <td style="width: 8%; vertical-align: top; padding: 4px 0; font-weight: bold; text-align: center; border: none; font-size: 11pt !important;">
                                                <span t-field="line.quantity" t-options='{"widget": "integer"}' style="font-size: 11pt !important;" />
                                            </td>
                                            <td style="width: 64%; vertical-align: top; padding: 4px 8px; text-align: left; border: none; line-height: 1.3; font-size: 11pt !important;">
                                                <span t-field="line.name" style="font-weight: bold; display: block; font-size: 11pt !important;"/>
                                                <div t-if="line.description" style="font-size: 11pt !important; color: #444; margin-top: 2px; line-height: 1.3;">
                                                    <span t-field="line.description" style="font-size: 11pt !important;"/>
                                                </div>
                                            </td>
                                            <td style="width: 13%; vertical-align: top; padding: 4px 10px 4px 0; text-align: right; border: none; font-size: 11pt !important; font-weight: bold; color: #000;">
                                                <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' style="font-size: 11pt !important; font-weight: bold;"/>
                                            </td>
                                            <td style="width: 15%; vertical-align: top; padding: 4px 0; font-weight: bold; text-align: right; border: none; font-size: 11pt !important;">
                                                <span t-field="line.total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' style="font-size: 11pt !important;" />
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <!-- CONTENEDOR DE TOTALES Y CONDICIONES (Para evitar firma huérfana) -->
                            <div style="page-break-inside: avoid; break-inside: avoid; margin-top: 4px;">
                                <!-- Totales de la opción -->
                                <table style="width: 100%; border-collapse: collapse; margin-bottom: 8px; table-layout: fixed !important;">
                                    <tbody>
                                        <t t-if="option.discount_total &gt; 0">
                                            <tr style="border: none;">
                                                <td style="width: 72%; border: none; padding: 1px 0;"/>
                                                <td style="width: 13%; border-top: 1px solid #eee; padding: 2px 0; text-align: right; font-size: 11pt !important; color: #666;">Subtotal sin Desc.:</td>
                                                <td style="width: 15%; border-top: 1px solid #eee; padding: 2px 0; text-align: right; font-size: 11pt !important; color: #666;">
                                                    <span t-field="option.amount_lines_before_discount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' style="font-size: 11pt !important;" />
                                                </td>
                                            </tr>
                                            <tr style="border: none;">
                                                <td style="border: none; padding: 1px 0;"/>
                                                <td style="padding: 2px 0; text-align: right; font-size: 11pt !important; color: #e04f4f;">Descuento:</td>
                                                <td style="padding: 2px 0; text-align: right; font-size: 11pt !important; color: #e04f4f;">
                                                    -<span t-field="option.discount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' style="font-size: 11pt !important;" />
                                                </td>
                                            </tr>
                                            <tr style="border: none;">
                                                <td style="border: none; padding: 1px 0;"/>
                                                <td style="padding: 2px 0; text-align: right; font-size: 11pt !important; color: #666;">Subtotal Neto:</td>
                                                <td style="padding: 2px 0; text-align: right; font-size: 11pt !important; color: #666;">
                                                    <span t-field="option.subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' style="font-size: 11pt !important;" />
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <tr style="border: none;">
                                                <td style="width: 72%; border: none; padding: 1px 0;"/>
                                                <td style="width: 13%; border-top: 1px solid #eee; padding: 2px 0; text-align: right; font-size: 11pt !important; color: #666;">Subtotal:</td>
                                                <td style="width: 15%; border-top: 1px solid #eee; padding: 2px 0; text-align: right; font-size: 11pt !important; color: #666;">
                                                    <span t-field="option.subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' style="font-size: 11pt !important;" />
                                                </td>
                                            </tr>
                                        </t>
                                        <tr style="border: none;">
                                            <td style="border: none; padding: 1px 0;"/>
                                            <td style="padding: 2px 0; text-align: right; font-size: 11pt !important; color: #666;">IVA:</td>
                                            <td style="padding: 2px 0; text-align: right; font-size: 11pt !important; color: #666;">
                                                <span t-field="option.iva_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' style="font-size: 11pt !important;" />
                                            </td>
                                        </tr>
                                        <tr style="border: none;">
                                            <td style="border: none; padding: 1px 0;"/>
                                            <td style="border-top: 1.5px solid #000; padding: 3px 0; text-align: right; font-size: 11pt !important; font-weight: bold; color: #000;">Total:</td>
                                            <td style="border-top: 1.5px solid #000; padding: 3px 0; text-align: right; font-size: 11pt !important; font-weight: bold; color: #000;">
                                                <span t-field="option.total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' style="font-size: 11pt !important;" />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <!-- Si es la última opción, pintar el total combinado, notas y firma -->
                                <t t-if="option_last">
                                    <!-- TOTAL COMBINADO DE OPCIONES -->
                                    <t t-if="doc.state == 'confirmed' and len(selected_opts) &gt; 1">
                                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 8px; table-layout: fixed !important;">
                                            <tbody>
                                                <tr style="border: none;">
                                                    <td style="width: 50%; border-top: 2px solid #1C355E; border-bottom: 2px solid #1C355E; padding: 5px 4px; text-align: right; font-weight: bold; font-size: 11pt !important; color: #1C355E; text-transform: uppercase;">
                                                        TOTAL OPCIONES SELECCIONADAS:
                                                    </td>
                                                    <td style="width: 50%; border-top: 2px solid #1C355E; border-bottom: 2px solid #1C355E; padding: 5px 0; text-align: right; font-weight: bold; font-size: 11pt !important; color: #1C355E;">
                                                        <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' style="font-size: 11pt !important;" />
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </t>

                                    <!-- CONDICIONES COMERCIALES / NOTAS -->
                                    <div style="margin-bottom: 12px; margin-top: 6px;">
                                        <t t-if="doc.notes">
                                            <t t-out="doc.notes"/>
                                        </t>
                                        <t t-else="">
                                            <p style="margin: 0; font-size: 11pt !important;">1.- Los precios incluyen IVA y son válidos por 10 días y/o agotar existencias.</p>
                                            <p style="margin: 0; font-size: 11pt !important;">2.- Tiempo de entrega: 2 - 3 días contra confirmación del pedido.</p>
                                            <p style="margin: 0; font-size: 11pt !important;">3.- Forma de pago: Contado anticipado para ordenar.</p>
                                        </t>
                                    </div>

                                    <!-- DESPEDIDA Y BLOQUE DE FIRMA -->
                                    <div style="margin-top: 8px;">
                                        <div style="text-align: left; margin-bottom: 14px; font-size: 11pt !important; line-height: 1.3; color: #000;">
                                            Sin más por el momento y a sus órdenes para cualquier duda ó aclaración, se despide de usted su S.S.
                                        </div>

                                        <div style="text-align: center; width: 100%;">
                                            <div style="display: inline-block; text-align: center; min-width: 280px; max-width: 440px;">
                                                <span style="font-weight: bold; text-transform: uppercase; display: block; margin-bottom: 2px; font-size: 11pt !important; letter-spacing: 1.5px; color: #000;">ATENTAMENTE</span>

                                                <!-- Imagen de firma -->
                                                <div style="height: 55px; position: relative; text-align: center; margin-bottom: 0px;">
                                                    <t t-if="doc.signature_id and doc.signature_id.signature_image">
                                                        <img t-attf-src="/web/image/seller.signature/{{ doc.signature_id.id }}/signature_image"
                                                            style="position: absolute; top: -35px; left: 50%; margin-left: -150px; width: 300px; max-height: 170px; z-index: 10; pointer-events: none; object-fit: contain;" />
                                                    </t>
                                                    <div t-if="not doc.signature_id or not doc.signature_id.signature_image" style="height: 55px;" />
                                                </div>

                                                <!-- Línea y nombre del vendedor -->
                                                <div style="border-top: 1.5px solid #000; padding-top: 4px; margin-top: 2px;">
                                                    <span t-field="doc.user_id.name"
                                                        style="font-weight: bold; text-transform: uppercase; display: block; font-size: 11pt !important; color: #000;" />
                                                    <span style="font-size: 11pt !important; display: block; color: #1C355E; margin-top: 2px; font-weight: bold; text-transform: uppercase;">CONSULTORÍA EN INFORMÁTICA ALSA</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>

                    <!-- PIE DE PÁGINA -->
                    <div class="footer"
                        style="font-family: 'Times New Roman', Times, serif !important; font-size: 11pt !important; color: #1C355E; width: 100% !important; border-top: 2px solid #1C355E; padding-top: 5px; margin: 0 !important; text-align: center !important; overflow: hidden;">
                        <div style="width: 100% !important; text-align: center !important; font-weight: bold; color: #1C355E; font-size: 11pt !important; margin-bottom: 2px; display: block !important;">
                            alsainformatica.com.mx &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;•&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; contacto@alsainformatica.com.mx
                        </div>
                        <div style="width: 100% !important; text-align: center !important; color: #333; font-size: 11pt !important; display: block !important;">
                            Av. Manuel J. Clouthier 182-C Col. El Ángel, C.P. 28979. Villa de Álvarez, Colima
                        </div>
                    </div>

                </t>
            </t>
        </t>
    </template>
</odoo>
