<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cotizacion_preview_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">

                    <!-- ENCABEZADO -->
                    <div class="header"
                        style="font-family: 'Arial', sans-serif; color: #1C355E; font-size: 11px; width: 100%; border-bottom: 2px solid #1C355E; padding-bottom: 4px; margin-bottom: 0px;">
                        <table style="width: 100%; border-collapse: collapse; border: none; background: transparent;">
                            <tr style="border: none;">
                                <td style="width: 40%; border: none; text-align: left; vertical-align: middle;">
                                    <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)"
                                        style="max-height: 45px; max-width: 100%;" alt="Logo ALSA" />
                                    <t t-if="not doc.company_id.logo">
                                        <strong style="font-size: 15px; color: #1C355E; letter-spacing: 1px;">ALSA</strong><br />
                                        <span style="font-size: 10px; color: #555; text-transform: uppercase;">Informática</span>
                                    </t>
                                </td>
                                <td style="width: 60%; border: none; text-align: right; line-height: 1.3; font-size: 10px; color: #333;">
                                    <strong style="font-size: 12px; color: #1C355E;">Alsa Informática</strong><br />
                                    <span>Conmutador: 312 311 23 25</span><br />
                                    <span>WhatsApp Ventas: 312 120 26 45</span>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- CUERPO PRINCIPAL -->
                    <div class="page"
                        style="font-family: 'Arial', sans-serif; color: #000; font-size: 13px; padding: 0px !important;">

                        <!-- 1. FECHA — margen positivo para que no quede tapada -->
                        <div style="text-align: right; width: 100%; font-size: 13px; margin-top: 10px; margin-bottom: 18px; color: #000;">
                            Colima, Col., <t t-if="doc.date">
                                <t t-esc="doc.date.strftime('%d')"/> de
                                <t t-set="months" t-value="['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre']"/>
                                <t t-esc="months[int(doc.date.strftime('%m'))-1]"/> de
                                <t t-esc="doc.date.strftime('%Y')"/>
                            </t>
                        </div>

                        <!-- 2. DATOS DEL CLIENTE -->
                        <div style="margin-bottom: 14px;">
                            <div style="text-transform: uppercase; font-weight: bold; line-height: 1.4; text-align: left;">
                                <span t-field="doc.partner_id.name"
                                    style="font-size: 15px; display: block; margin-bottom: 2px;" />
                                <span t-if="doc.partner_id.street"
                                    style="font-weight: normal; font-size: 12px; color: #222; display: block; margin-top: 0; text-transform: none;">
                                    <span t-field="doc.partner_id.street" />
                                    <span t-if="doc.partner_id.street2">, <span t-field="doc.partner_id.street2" /></span>
                                    <span t-if="doc.partner_id.zip">, C.P. <span t-field="doc.partner_id.zip" /></span>
                                </span>
                                <span style="display: block; font-size: 13px; font-weight: normal; margin-top: 3px; text-transform: none;">
                                    AT'N: <t t-if="doc.partner_id.child_ids"><span t-field="doc.partner_id.child_ids[0].name" /></t>
                                    <t t-else=""><span t-field="doc.partner_id.name" /></t>
                                </span>
                                <span style="letter-spacing: 2px; display: block; margin-top: 4px; font-size: 13px;">P R E S E N T E</span>
                            </div>
                        </div>

                        <!-- 3. TABLA DE PRODUCTOS -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
                            <thead>
                                <tr style="border-top: 1.5px solid #000; border-bottom: 1.5px solid #000; text-transform: uppercase; font-weight: bold; font-size: 11px;">
                                    <th style="width: 7%; border: none; padding: 4px 0; text-align: center;">CANT.</th>
                                    <th style="width: 48%; border: none; padding: 4px 4px; text-align: left;">DESCRIPCIÓN</th>
                                    <th style="width: 15%; border: none; padding: 4px 0; text-align: right;">P. UNITARIO</th>
                                    <th style="width: 12%; border: none; padding: 4px 0; text-align: right;">IVA (16%)</th>
                                    <th style="width: 18%; border: none; padding: 4px 0; text-align: right;">TOTAL C/IVA</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.option_ids" t-as="option">
                                    <!-- Nombre de la Opción como sección -->
                                    <tr style="border: none;">
                                        <td colspan="5"
                                            style="padding: 8px 0 3px 0; font-weight: bold; text-transform: uppercase; font-size: 12px; text-align: left; border: none; color: #1C355E; border-bottom: 1px solid #dee2e6;">
                                            <span t-field="option.name" />
                                        </td>
                                    </tr>
                                    <!-- Descripción General de la Opción (Vendedor) -->
                                    <tr t-if="option.description" style="border: none;">
                                        <td colspan="5" style="border: none; padding: 4px 6px; font-size: 12px; color: #444; line-height: 1.35;">
                                            <span t-field="option.description"/>
                                        </td>
                                    </tr>
                                    <!-- Filas de Productos -->
                                    <t t-foreach="option.line_ids" t-as="line">
                                        <tr style="border: none;">
                                            <td style="vertical-align: top; padding: 4px 0; font-weight: bold; text-align: center; border: none; font-size: 13px;">
                                                <span t-field="line.quantity" t-options="{&quot;widget&quot;: &quot;integer&quot;}" />
                                            </td>
                                            <td style="vertical-align: top; padding: 4px 4px; text-align: left; border: none; line-height: 1.3; font-size: 13px;">
                                                <span t-field="line.name" style="font-weight: bold; display: block;"/>
                                                <div t-if="line.description"
                                                     style="font-size: 11.5px; color: #444; margin-top: 4px; line-height: 1.4;">
                                                    <span t-field="line.description"/>
                                                </div>
                                            </td>
                                            <td style="vertical-align: top; padding: 4px 0; text-align: right; border: none; font-size: 13px;">
                                                <span t-field="line.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                            </td>
                                            <td style="vertical-align: top; padding: 4px 0; text-align: right; border: none; font-size: 13px; color: #444;">
                                                <span t-out="line.price_unit * line.quantity * (line.iva_percent / 100.0)"
                                                    t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                            </td>
                                            <td style="vertical-align: top; padding: 4px 0; font-weight: bold; text-align: right; border: none; font-size: 13px;">
                                                <span t-out="line.price_unit * line.quantity * (1 + line.iva_percent / 100.0)"
                                                    t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                            </td>
                                        </tr>
                                    </t>
                                    <!-- Subtotales por opción -->
                                    <tr style="border: none;">
                                        <td colspan="3" style="border: none; padding: 2px 0;"/>
                                        <td style="border-top: 1px solid #ccc; padding: 3px 0; text-align: right; font-size: 11px; color: #555; border-left: none; border-right: none; border-bottom: none;">Subtotal:</td>
                                        <td style="border-top: 1px solid #ccc; padding: 3px 0; font-weight: bold; text-align: right; font-size: 12px; border-left: none; border-right: none; border-bottom: none;">
                                            <span t-field="option.total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- 4. CONDICIONES Y FIRMA -->
                        <div style="page-break-inside: avoid; margin-top: 80px;">

                            <!-- CONDICIONES COMERCIALES -->
                            <div style="font-size: 11px; line-height: 1.6; text-align: left; margin-bottom: 16px; color: #333;">
                                <t t-if="doc.notes">
                                    <t t-raw="doc.notes"/>
                                </t>
                                <t t-else="">
                                    <p style="margin: 2px 0;">1.- Los precios incluyen IVA y son válidos por 10 días y/o agotar existencias.</p>
                                    <p style="margin: 2px 0;">2.- Tiempo de entrega: 2 - 3 días contra confirmación del pedido.</p>
                                    <p style="margin: 2px 0;">3.- Forma de pago: Contado anticipado para ordenar.</p>
                                </t>
                            </div>

                            <!-- DESPEDIDA -->
                            <div style="text-align: left; margin-bottom: 30px; font-size: 12px; line-height: 1.5; color: #000;">
                                Sin más por el momento y a sus órdenes para cualquier duda ó aclaración, se despide de usted su S.S.
                            </div>

                            <!-- BLOQUE DE FIRMA -->
                            <div style="margin-top: 90px; text-align: center; width: 100%; page-break-inside: avoid;">
                                <div style="display: inline-block; text-align: center; min-width: 280px; max-width: 440px;">
                                    <span style="font-weight: bold; text-transform: uppercase; display: block; margin-bottom: 10px; font-size: 12px; letter-spacing: 1.5px; color: #000;">ATENTAMENTE</span>

                                    <!-- Imagen de firma grande -->
                                    <div style="height: 150px; text-align: center; margin-bottom: 6px;">
                                        <t t-if="doc.signature_id and doc.signature_id.signature_image">
                                            <img t-attf-src="/web/image/seller.signature/{{ doc.signature_id.id }}/signature_image"
                                                style="max-height: 140px; max-width: 340px; display: inline-block;" />
                                        </t>
                                        <div t-if="not doc.signature_id or not doc.signature_id.signature_image" style="height: 140px;" />
                                    </div>

                                    <!-- Línea y nombre del vendedor -->
                                    <div style="border-top: 1.5px solid #000; padding-top: 5px; margin-top: 2px;">
                                        <span t-field="doc.user_id.name"
                                            style="font-weight: bold; text-transform: uppercase; display: block; font-size: 13px; color: #000;" />
                                        <span style="font-size: 11px; display: block; color: #1C355E; margin-top: 3px; font-weight: bold; text-transform: uppercase;">CONSULTORÍA EN INFORMÁTICA ALSA S.A. DE C.V.</span>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>

                    <!-- PIE DE PÁGINA -->
                    <div class="footer"
                        style="font-family: 'Arial', sans-serif; color: #1C355E; font-size: 10px; width: 100%; border-top: 1.5px solid #1C355E; padding-top: 3px;">
                        <table style="width: 100%; border-collapse: collapse; border: none; background: transparent;">
                            <tr style="border: none;">
                                <td style="width: 50%; text-align: left; padding: 1px 0; border: none; font-weight: bold; color: #1C355E;">alsainformatica.com.mx</td>
                                <td style="width: 50%; text-align: right; padding: 1px 0; border: none; font-weight: bold; color: #1C355E;">contacto@alsainformatica.com.mx</td>
                            </tr>
                            <tr style="border: none;">
                                <td colspan="2"
                                    style="text-align: center; padding: 1px 0 0 0; border: none; color: #555; font-size: 9px;">
                                    Av. Manuel J. Clouthier 182-C Col. El Ángel, C.P. 28979. Villa de Álvarez, Colima
                                </td>
                            </tr>
                        </table>
                    </div>

                </t>
            </t>
        </t>
    </template>
</odoo>
