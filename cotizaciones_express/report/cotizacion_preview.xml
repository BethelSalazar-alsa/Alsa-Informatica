<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cotizacion_preview_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">

                    <!-- PIE DE PÁGINA FIJO AL FINAL -->
                    <div class="footer"
                        style="font-family: 'Arial', sans-serif; color: #1C355E; font-size: 11px; width: 100%; border-top: 1px solid #1C355E; padding-top: 8px;">
                        <table style="width: 100%; border-collapse: collapse; border: none; background: transparent;">
                            <tr style="border: none;">
                                <td style="width: 50%; text-align: left; padding: 2px 0; border: none; font-weight: bold; color: #1C355E;">
                                    www.alsainformatica.com.mx
                                </td>
                                <td style="width: 50%; text-align: right; padding: 2px 0; border: none; font-weight: bold; color: #1C355E;">
                                    contacto@alsainformatica.com.mx
                                </td>
                            </tr>
                            <tr style="border: none;">
                                <td colspan="2"
                                    style="width: 100%; text-align: left; padding: 5px 0 0 0; border: none; color: #444; font-size: 11px;">
                                    Av. Manuel J. Clouthier 182-C Col. El Ángel, C.P. 28979. Villa de Álvarez, Colima
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- CUERPO PRINCIPAL DEL DOCUMENTO -->
                    <div class="page" style="font-family: 'Arial', sans-serif; color: #000; font-size: 13px;">

                        <!-- 1. FECHA -->
                        <div class="row justify-content-end"
                            style="margin-bottom: 25px; margin-top: -10px; page-break-inside: avoid; text-align: right;">
                            <div class="col-auto text-right" style="text-align: right; width: 100%; font-size: 13px;">
                                Colima, Col., <span t-if="doc.date">
                                    <t t-esc="doc.date.strftime('%d')"/> de 
                                    <t t-set="months" t-value="['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre']"/>
                                    <t t-esc="months[int(doc.date.strftime('%m'))-1]"/> de 
                                    <t t-esc="doc.date.strftime('%Y')"/>
                                </span>
                            </div>
                        </div>

                        <!-- 2. DATOS DEL CLIENTE -->
                        <div class="row" style="margin-bottom: 25px; page-break-inside: avoid;">
                            <div class="col-12"
                                style="text-transform: uppercase; font-weight: bold; line-height: 1.3; text-align: left; font-size: 14px;">
                                <span t-field="doc.partner_id.name"
                                    style="font-size: 15px; display: block; margin-bottom: 2px;" /><br />

                                <span t-if="doc.partner_id.street"
                                    style="font-weight: normal; font-size: 12px; color: #222; display: block; text-transform: uppercase; margin-bottom: 2px; margin-top: -10px;">
                                    <span t-field="doc.partner_id.street" />
                                    <span t-if="doc.partner_id.street2">, <span t-field="doc.partner_id.street2" /></span>
                                    <span t-if="doc.partner_id.zip">, C.P. <span t-field="doc.partner_id.zip" /></span>
                                </span>

                                <span style="display: block; font-size: 13px; margin-top: 2px;">
                                    AT'N: <t t-if="doc.partner_id.child_ids"><span
                                            t-field="doc.partner_id.child_ids.name" /></t>
                                    <t t-else=""><span t-field="doc.partner_id.name" /></t>
                                </span>

                                <span style="letter-spacing: 2px; display: block; margin-top: 3px; font-size: 13px;">P R E S E N T E</span>
                            </div>
                        </div>

                        <!-- 3. TABLA DE PRODUCTOS AGRUPADA POR OPCIONES -->
                        <t t-foreach="doc.option_ids" t-as="option">
                            <div style="font-weight: bold; text-transform: uppercase; font-size: 12px; text-align: left; margin-top: 15px; margin-bottom: 5px; color: #1C355E; page-break-inside: avoid;">
                                <span t-field="option.name" /> <t t-if="option.selected">(SELECCIONADA)</t>
                            </div>
                            <div t-if="option.description" style="font-size: 11px; margin-bottom: 5px; color: #555; page-break-inside: avoid;">
                                <t t-raw="option.description"/>
                            </div>

                            <table class="table table-sm" style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                                <thead>
                                    <tr style="border-top: 1px solid #000; border-bottom: 1px solid #000; text-transform: uppercase; font-weight: bold; font-size: 12px;">
                                        <th style="width: 10%; border: none; padding: 6px 0; text-align: center;">CANT.</th>
                                        <th style="width: 70%; border: none; padding: 6px 5px; text-align: left;">DESCRIPCIÓN</th>
                                        <th style="width: 20%; border: none; padding: 4px 0; text-align: right;">PRECIO</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="option.line_ids" t-as="line">
                                        <tr style="border: none;">
                                            <td style="vertical-align: top; padding: 4px 0; font-weight: bold; text-align: center; border: none; font-size: 12px;">
                                                <span t-field="line.quantity" t-options="{&quot;widget&quot;: &quot;integer&quot;}" />
                                            </td>
                                            <td style="vertical-align: top; padding: 4px 5px; text-align: left; border: none; line-height: 1.35; font-size: 12px; white-space: normal;">
                                                <span t-field="line.name" />
                                                <t t-if="line.description"><br/><span t-raw="line.description" style="font-size: 11px; color: #555;"/></t>
                                            </td>
                                            <td style="vertical-align: top; padding: 4px 0; font-weight: bold; text-align: right; border: none; font-size: 12px;">
                                                <span t-field="line.total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                            </td>
                                        </tr>
                                    </t>
                                    <tr style="border-top: 1px solid #000; border-bottom: 1px solid #000; font-weight: bold; font-size: 12px;">
                                        <td colspan="2" style="text-align: right; padding: 4px 5px; border: none; text-transform: uppercase;">TOTAL <span t-field="option.name"/>:</td>
                                        <td style="text-align: right; padding: 4px 0; border: none;">
                                            <span t-field="option.total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <!-- 4. CONDICIONES COMERCIALES -->
                        <div style="font-size: 11px; line-height: 1.4; text-align: left; margin-top: 10px; margin-bottom: 15px; page-break-inside: avoid;">
                            <t t-if="doc.notes">
                                <t t-raw="doc.notes"/>
                            </t>
                            <t t-else="">
                                <div>1.- Los precios incluyen IVA y son válidos por 10 días y/o agotar existencias.</div>
                                <div>2.- Tiempo de entrega: 2 - 3 días contra confirmación del pedido.</div>
                                <div>3.- Forma de pago: Contado anticipado para ordenar.</div>
                            </t>
                        </div>

                        <!-- 5. MENSAJE DE DESPEDIDA -->
                        <div style="text-align: left; margin-bottom: 30px; font-size: 12px; page-break-inside: avoid;">
                            Sin más por el momento y a sus órdenes para cualquier duda ó aclaración, se despide de usted su S.S.
                        </div>

                        <!-- 6. BLOQUE DE FIRMA -->
                        <div style="margin-top: 35px; text-align: center; width: 100%; page-break-inside: avoid; margin-bottom: 20px;">
                            <div style="margin: 0 auto; text-align: center; max-width: 440px;">
                                <span style="font-weight: bold; text-transform: uppercase; display: block; margin-bottom: 3px; font-size: 12px; letter-spacing: 1px;">ATENTAMENTE</span>

                                <div style="height: 80px; position: relative; display: flex; align-items: center; justify-content: center; margin-bottom: 3px;">
                                    <t t-if="doc.signature_id and doc.signature_id.signature_image">
                                        <img t-attf-src="/cotizacion/image/seller.signature/{{ doc.signature_id.id }}/signature_image"
                                             style="max-height: 80px; max-width: 220px; object-fit: contain;" />
                                    </t>
                                </div>

                                <div style="border-top: 1.5px solid #000; padding-top: 5px;">
                                    <span t-field="doc.user_id.name" style="font-weight: bold; text-transform: uppercase; display: block; font-size: 12px; color: #000;" />
                                    <span style="font-weight: bold; text-transform: uppercase; font-size: 11px; display: block; color: #000; margin-top: 1px;">CONSULTORÍA EN INFORMÁTICA ALSA S.A. DE C.V.</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
