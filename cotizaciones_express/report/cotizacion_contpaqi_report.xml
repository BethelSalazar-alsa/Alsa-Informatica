<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plantilla inactiva para asegurar compatibilidad y mantener Ventas nativas -->
    <record id="report_saleorder_document_override" model="ir.ui.view">
        <field name="name">report_saleorder_document_override</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.report_saleorder_document"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-call='web.external_layout']" position="replace">
                <t t-call="web.external_layout">
                    <t t-set="doc" t-value="doc or o"/>
                    <div class="page"/>
                </t>
            </xpath>
        </field>
    </record>

    <!-- Restaurar el formato de papel por defecto en la acción de Ventas -->
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="paperformat_id" eval="False"/>
    </record>
</odoo>


