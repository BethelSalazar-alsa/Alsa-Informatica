<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seller_signature_list" model="ir.ui.view">
        <field name="name">seller.signature.list</field>
        <field name="model">seller.signature</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
                <field name="signature_name"/>
                <field name="signature_image" widget="image"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_seller_signature_form" model="ir.ui.view">
        <field name="name">seller.signature.form</field>
        <field name="model">seller.signature</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="signature_name"/>
                        </group>
                        <group>
                            <field name="signature_image" widget="image" class="oe_avatar"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seller_signature" model="ir.actions.act_window">
        <field name="name">Firmas de Vendedores</field>
        <field name="res_model">seller.signature</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_cotizaciones_root" name="Cotizaciones Express" sequence="20"/>
    <menuitem id="menu_seller_signatures" name="Firmas de Vendedores" parent="menu_cotizaciones_root" action="action_seller_signature" sequence="30"/>
</odoo>
