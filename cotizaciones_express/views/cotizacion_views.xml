<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cotizacion_express_tree" model="ir.ui.view">
        <field name="name">cotizacion.express.tree</field>
        <field name="model">cotizacion.express</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="amount_total" sum="Total de Cotizaciones"/>
                <field name="amount_confirmed" sum="Total Vendido (Confirmado)"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'sent'" decoration-warning="state == 'draft'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_cotizacion_express_form" model="ir.ui.view">
        <field name="name">cotizacion.express.form</field>
        <field name="model">cotizacion.express</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_to_client" string="Enviar al Cliente" type="object" class="oe_highlight" invisible="state not in ['draft']"/>
                    <button name="action_confirm" string="Confirmar Venta" type="object" class="oe_highlight" invisible="state not in ['draft', 'sent']"/>
                    <button name="action_draft" string="Volver a Borrador" type="object" invisible="state == 'draft'"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state in ['draft', 'cancelled']"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>

                <sheet>
                    <div class="row" style="display:flex; gap: 0;">
                        <div class="col-lg-7" style="flex: 6; padding-right: 15px; border-right: 1px solid #dee2e6;">
                            <div class="oe_title">
                                <h1><field name="name" placeholder="Cotización"/></h1>
                            </div>

                            <group>
                                <group>
                                    <field name="partner_id" options="{'no_create': True}" context="{'show_address': True}"/>
                                    <field name="date"/>
                                    <field name="city"/>
                                    <field name="state_location"/>
                                </group>
                                <group>
                                    <field name="user_id"/>
                                    <field name="signature_id" options="{'no_create': True}"/>
                                    <field name="crm_lead_id" options="{'no_create': True}"/>
                                </group>
                            </group>

                            <notebook>
                                <page string="Opciones" name="options">
                                    <field name="option_ids"/>
                                </page>
                                <page string="Términos" name="notes">
                                    <field name="notes" widget="html"/>
                                </page>
                            </notebook>
                        </div>

                        <div class="col-lg-5" style="flex: 4; padding-left: 15px; background: #f8f9fa; min-height: 600px; position: sticky; top: 0;">
                            <div style="width: 100%; height: 680px; border: 1px solid #dee2e6; border-radius: 4px; overflow: hidden; background: #fff;">
                                <field name="pdf_preview" nolabel="1" readonly="1" style="width: 100%; height: 680px;"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cotizacion_express_option_tree" model="ir.ui.view">
        <field name="name">cotizacion.express.option.tree</field>
        <field name="model">cotizacion.express.option</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="selected" widget="badge" decoration-success="selected == True"/>
                <field name="subtotal" sum="Subtotal"/>
                <field name="iva_total" sum="IVA"/>
                <field name="total" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_cotizacion_express_option_form" model="ir.ui.view">
        <field name="name">cotizacion.express.option.form</field>
        <field name="model">cotizacion.express.option</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="selected"/>
                        <field name="subtotal"/>
                        <field name="iva_total"/>
                        <field name="total"/>
                    </group>
                </group>
                <group string="Descripción">
                    <field name="description" widget="html" nolabel="1" options="{'default_height': '300px'}"/>
                </group>
                <group string="Productos">
                    <field name="line_ids" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_cotizacion_express_option_line_tree" model="ir.ui.view">
        <field name="name">cotizacion.express.option.line.tree</field>
        <field name="model">cotizacion.express.option.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="quantity"/>
                <field name="price_unit"/>
                <field name="iva_percent"/>
                <field name="subtotal" sum="Subtotal"/>
                <field name="iva_amount" sum="IVA"/>
                <field name="total" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_cotizacion_express_option_line_form" model="ir.ui.view">
        <field name="name">cotizacion.express.option.line.form</field>
        <field name="model">cotizacion.express.option.line</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="quantity"/>
                        <field name="price_unit"/>
                    </group>
                    <group>
                        <field name="iva_percent"/>
                        <field name="subtotal" readonly="1"/>
                        <field name="iva_amount" readonly="1"/>
                        <field name="total" readonly="1"/>
                    </group>
                </group>
                <separator string="Descripción"/>
                <field name="description" widget="html" nolabel="1"
                       options="{&apos;height&apos;: 300, &apos;toolbar&apos;: true}"
                       style="min-height: 250px; width: 100%;"/>
            </form>
        </field>
    </record>

    <record id="view_cotizacion_express_kanban" model="ir.ui.view">
        <field name="name">cotizacion.express.kanban</field>
        <field name="model">cotizacion.express</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" quick_create="false" on_create="quick_create">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="amount_total"/>
                <field name="currency_id"/>
                <field name="stage_id"/>
                <field name="state"/>
                <progressbar field="state" colors='{"draft": "warning", "sent": "info", "confirmed": "success", "cancelled": "danger"}' sum_field="amount_total"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong style="font-size: 14px; color: #1C355E;">
                                <field name="name"/>
                            </strong>
                            <div class="text-muted" style="font-size: 12px; margin-top: 2px;">
                                <field name="partner_id"/>
                            </div>
                            <div class="text-muted" style="font-size: 11px; margin-top: 2px;">
                                <field name="date"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <field name="user_id" widget="many2one_avatar_user"/>
                                <strong style="color: #28a745; font-size: 14px;">
                                    <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_cotizacion_express_search" model="ir.ui.view">
        <field name="name">cotizacion.express.search</field>
        <field name="model">cotizacion.express</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Cotización"/>
                <field name="partner_id" string="Cliente"/>
                <filter string="Borrador" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Enviadas" name="filter_sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Confirmadas" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
            </search>
        </field>
    </record>

    <!-- VISTAS PARA ETAPAS -->
    <record id="view_cotizacion_express_stage_list" model="ir.ui.view">
        <field name="name">cotizacion.express.stage.list</field>
        <field name="model">cotizacion.express.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state_type"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="view_cotizacion_express_stage_form" model="ir.ui.view">
        <field name="name">cotizacion.express.stage.form</field>
        <field name="model">cotizacion.express.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="state_type"/>
                            <field name="fold"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VISTAS DE REPORTES PARA COTIZACION.EXPRESS -->
    <record id="view_cotizacion_express_graph" model="ir.ui.view">
        <field name="name">cotizacion.express.graph</field>
        <field name="model">cotizacion.express</field>
        <field name="arch" type="xml">
            <graph string="Resultados de Ventas por Vendedor" type="bar" sample="1">
                <field name="user_id" type="row"/>
                <field name="amount_confirmed" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_cotizacion_express_pivot" model="ir.ui.view">
        <field name="name">cotizacion.express.pivot</field>
        <field name="model">cotizacion.express</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Cotizaciones" sample="1">
                <field name="user_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- VISTAS DE REPORTES PARA COTIZACION.EXPRESS.OPTION.LINE -->
    <record id="view_cotizacion_express_option_line_graph" model="ir.ui.view">
        <field name="name">cotizacion.express.option.line.graph</field>
        <field name="model">cotizacion.express.option.line</field>
        <field name="arch" type="xml">
            <graph string="Resultados de Ventas por Producto" type="bar" sample="1">
                <field name="name" type="row"/>
                <field name="total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_cotizacion_express_option_line_pivot" model="ir.ui.view">
        <field name="name">cotizacion.express.option.line.pivot</field>
        <field name="model">cotizacion.express.option.line</field>
        <field name="arch" type="xml">
            <pivot string="Resultados de Ventas" sample="1">
                <field name="name" type="row"/>
                <field name="user_id" type="col"/>
                <field name="total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_cotizacion_express_option_line_search" model="ir.ui.view">
        <field name="name">cotizacion.express.option.line.search</field>
        <field name="model">cotizacion.express.option.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Producto"/>
                <field name="user_id" string="Vendedor"/>
                <field name="partner_id" string="Cliente"/>
                <field name="cotizacion_state" invisible="1"/>
                <field name="option_selected" invisible="1"/>
                <field name="date" invisible="1"/>
                <filter string="Vendido (Confirmado)" name="filter_sold" domain="[('cotizacion_state', '=', 'confirmed'), ('option_selected', '=', True)]"/>
                <separator/>
                <filter string="Producto/Concepto" name="group_product" context="{'group_by':'name'}"/>
                <filter string="Vendedor" name="group_user" context="{'group_by':'user_id'}"/>
                <filter string="Cliente" name="group_partner" context="{'group_by':'partner_id'}"/>
                <filter string="Fecha" name="group_date" context="{'group_by':'date'}"/>
            </search>
        </field>
    </record>

    <record id="action_cotizacion_express_report" model="ir.actions.act_window">
        <field name="name">Resultados de Ventas</field>
        <field name="res_model">cotizacion.express.option.line</field>
        <field name="view_mode">list,graph</field>
        <field name="domain">[('cotizacion_state', '=', 'confirmed'), ('option_selected', '=', True)]</field>
        <field name="context">{'search_default_group_product': 1}</field>
    </record>

    <record id="action_cotizacion_express" model="ir.actions.act_window">
        <field name="name">Cotizaciones Express</field>
        <field name="res_model">cotizacion.express</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_cotizacion_express_stage" model="ir.actions.act_window">
        <field name="name">Etapas de Cotización</field>
        <field name="res_model">cotizacion.express.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENUS -->
    <menuitem id="menu_cotizaciones_list" name="Cotizaciones" parent="menu_cotizaciones_root" action="action_cotizacion_express" sequence="10"/>
    <menuitem id="menu_cotizacion_express_report" name="Resultados de Ventas" parent="menu_cotizaciones_root" action="action_cotizacion_express_report" sequence="20"/>
    <menuitem id="menu_cotizacion_express_stage" name="Etapas" parent="menu_cotizaciones_root" action="action_cotizacion_express_stage" sequence="40"/>
</odoo>
