<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cotizacion_express_tree" model="ir.ui.view">
        <field name="name">cotizacion.express.tree</field>
        <field name="model">cotizacion.express</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="user_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_total" sum="Total de Cotizaciones"/>
                <field name="amount_confirmed" sum="Total Vendido (Confirmado)"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'sent'" decoration-warning="state == 'draft'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_cotizacion_express_form" model="ir.ui.view">
        <field name="name">cotizacion.express.form</field>
        <field name="model">cotizacion.express</field>
        <field name="arch" type="xml">
            <form class="o_cotizacion_express_form" autosave="1">
                <header>
                    <button name="action_send_to_client" string="Enviar al Cliente" type="object" class="oe_highlight" invisible="state not in ['draft']"/>
                    <button name="action_confirm" string="Confirmar Venta" type="object" class="oe_highlight" invisible="state not in ['draft', 'sent']"/>
                    <button name="action_draft" string="Volver a Borrador" type="object" invisible="state == 'draft'"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state in ['draft', 'cancelled']"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>

                <sheet class="o_cotizacion_express_sheet">
                    <div style="display: flex; width: 100%; gap: 16px;">
                        <div style="flex: 1.4; min-width: 0; border-right: 1px solid #dee2e6; padding-right: 16px;">
                            <div class="oe_title">
                                <h1><field name="name" placeholder="Cotización"/></h1>
                            </div>

                            <group>
                                <group>
                                    <field name="partner_id" context="{'show_address': True}"/>
                                    <field name="date"/>
                                    <field name="city"/>
                                    <field name="state_location"/>
                                </group>
                                <group>
                                    <field name="user_id"/>
                                    <field name="signature_id" options="{'no_create': True}"/>
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                </group>
                            </group>

                            <group string="Plantillas y Paquetes">
                                <group>
                                    <label for="template_id"/>
                                    <div class="o_row">
                                        <field name="template_id" options="{'no_create': True}" placeholder="Seleccionar Plantilla..."/>
                                        <button name="action_load_template" type="object" string="Aplicar Plantilla" class="btn-primary" invisible="not template_id" confirm="¿Está seguro de aplicar esta plantilla? Se borrarán todas las opciones de la cotización actual."/>
                                    </div>
                                </group>
                                <group>
                                    <label for="option_template_id"/>
                                    <div class="o_row">
                                        <field name="option_template_id" options="{'no_create': True}" placeholder="Seleccionar Paquete..."/>
                                        <button name="action_load_option_template" type="object" string="Agregar Paquete" class="btn-secondary" invisible="not option_template_id"/>
                                    </div>
                                </group>
                            </group>

                            <notebook>
                                <page string="Opciones" name="options">
                                    <field name="option_ids"/>
                                </page>
                                <page string="Términos" name="notes">
                                    <field name="notes" widget="html"/>
                                </page>
                            </notebook>
                        </div>

                        <div style="flex: 1; background: #f8f9fa; min-height: 600px; position: sticky; top: 0; border-radius: 6px; padding: 16px;">
                            <div style="width: 100%; height: 100%; min-height: 650px; background: #fff; border-radius: 4px;">
                                <field name="pdf_filename" invisible="1"/>
                                <field name="pdf_toggle" invisible="1"/>
                                <field name="pdf_preview" widget="pdf_viewer" filename="pdf_filename" nolabel="1" readonly="1" style="width: 100%; height: 650px;" invisible="pdf_toggle"/>
                                <field name="pdf_preview" widget="pdf_viewer" filename="pdf_filename" nolabel="1" readonly="1" style="width: 100%; height: 650px;" invisible="not pdf_toggle"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cotizacion_express_option_tree" model="ir.ui.view">
        <field name="name">cotizacion.express.option.tree</field>
        <field name="model">cotizacion.express.option</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="selected"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="subtotal" sum="Subtotal"/>
                <field name="iva_total" sum="IVA"/>
                <field name="total" sum="Total"/>
                <button name="action_duplicate" type="object" icon="fa-copy" title="Duplicar"/>
            </list>
        </field>
    </record>

    <record id="view_cotizacion_express_option_form" model="ir.ui.view">
        <field name="name">cotizacion.express.option.form</field>
        <field name="model">cotizacion.express.option</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="discount_general"/>
                    </group>
                    <group>
                        <field name="selected"/>
                        <field name="amount_lines_subtotal" string="Subtotal Líneas" readonly="1"/>
                        <field name="discount_general_amount" string="Monto Desc. General" readonly="1"/>
                        <field name="subtotal" string="Subtotal Neto" readonly="1"/>
                        <field name="iva_total" string="IVA Total" readonly="1"/>
                        <field name="total" string="Total" readonly="1"/>
                    </group>
                </group>
                <group string="Descripción">
                    <field name="description" widget="html" nolabel="1" options="{'default_height': '300px'}"/>
                </group>
                <group string="Productos">
                    <field name="line_ids" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_cotizacion_express_option_line_tree" model="ir.ui.view">
        <field name="name">cotizacion.express.option.line.tree</field>
        <field name="model">cotizacion.express.option.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="quantity"/>
                <field name="price_unit"/>
                <field name="discount"/>
                <field name="iva_percent"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="subtotal" sum="Subtotal"/>
                <field name="iva_amount" sum="IVA"/>
                <field name="total" sum="Total"/>
                <button name="action_duplicate_line" type="object" icon="fa-copy" title="Duplicar"/>
            </list>
        </field>
    </record>

    <record id="view_cotizacion_express_option_line_form" model="ir.ui.view">
        <field name="name">cotizacion.express.option.line.form</field>
        <field name="model">cotizacion.express.option.line</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="quantity"/>
                        <field name="price_unit"/>
                        <field name="discount"/>
                    </group>
                    <group>
                        <field name="iva_percent"/>
                        <field name="subtotal" readonly="1"/>
                        <field name="iva_amount" readonly="1"/>
                        <field name="total" readonly="1"/>
                    </group>
                </group>
                <separator string="Descripción"/>
                <field name="description" widget="html" nolabel="1"
                       options="{&apos;height&apos;: 300, &apos;toolbar&apos;: true}"
                       style="min-height: 250px; width: 100%;"/>
            </form>
        </field>
    </record>

    <record id="view_cotizacion_express_kanban" model="ir.ui.view">
        <field name="name">cotizacion.express.kanban</field>
        <field name="model">cotizacion.express</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" default_order="date desc" quick_create="false" on_create="quick_create">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="amount_total"/>
                <field name="currency_id"/>
                <field name="stage_id"/>
                <field name="state"/>
                <progressbar field="state" colors='{"draft": "warning", "sent": "info", "confirmed": "success", "cancelled": "danger"}' sum_field="amount_total"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong style="font-size: 14px; color: #1C355E;">
                                <field name="name"/>
                            </strong>
                            <div class="text-muted" style="font-size: 12px; margin-top: 2px;">
                                <field name="partner_id"/>
                            </div>
                            <div class="text-muted" style="font-size: 11px; margin-top: 2px;">
                                <field name="date"/>
                            </div>
                             <div class="d-flex justify-content-between align-items-center mt-2">
                                <field name="user_id" widget="many2one_avatar_user"/>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                <strong style="color: #28a745; font-size: 14px;">
                                    <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_cotizacion_express_search" model="ir.ui.view">
        <field name="name">cotizacion.express.search</field>
        <field name="model">cotizacion.express</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Cotización"/>
                <field name="partner_id" string="Cliente"/>
                <field name="tag_ids" string="Etiqueta"/>
                <filter string="Borrador" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Enviadas" name="filter_sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Confirmadas" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
            </search>
        </field>
    </record>

    <!-- VISTAS PARA ETAPAS -->
    <record id="view_cotizacion_express_stage_list" model="ir.ui.view">
        <field name="name">cotizacion.express.stage.list</field>
        <field name="model">cotizacion.express.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state_type"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="view_cotizacion_express_stage_form" model="ir.ui.view">
        <field name="name">cotizacion.express.stage.form</field>
        <field name="model">cotizacion.express.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="state_type"/>
                            <field name="fold"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VISTAS DE REPORTES PARA COTIZACION.EXPRESS -->
    <record id="view_cotizacion_express_graph" model="ir.ui.view">
        <field name="name">cotizacion.express.graph</field>
        <field name="model">cotizacion.express</field>
        <field name="arch" type="xml">
            <graph string="Resultados de Ventas por Vendedor" type="bar" sample="1">
                <field name="user_id" type="row"/>
                <field name="amount_confirmed" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_cotizacion_express_pivot" model="ir.ui.view">
        <field name="name">cotizacion.express.pivot</field>
        <field name="model">cotizacion.express</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Cotizaciones" sample="1">
                <field name="user_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- VISTAS DE REPORTES PARA COTIZACION.EXPRESS.OPTION.LINE -->
    <record id="view_cotizacion_express_option_line_graph" model="ir.ui.view">
        <field name="name">cotizacion.express.option.line.graph</field>
        <field name="model">cotizacion.express.option.line</field>
        <field name="arch" type="xml">
            <graph string="Resultados de Ventas por Producto" type="bar" sample="1">
                <field name="name" type="row"/>
                <field name="total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_cotizacion_express_option_line_pivot" model="ir.ui.view">
        <field name="name">cotizacion.express.option.line.pivot</field>
        <field name="model">cotizacion.express.option.line</field>
        <field name="arch" type="xml">
            <pivot string="Resultados de Ventas" sample="1">
                <field name="name" type="row"/>
                <field name="user_id" type="col"/>
                <field name="total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_cotizacion_express_option_line_search" model="ir.ui.view">
        <field name="name">cotizacion.express.option.line.search</field>
        <field name="model">cotizacion.express.option.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Producto"/>
                <field name="user_id" string="Vendedor"/>
                <field name="partner_id" string="Cliente"/>
                <filter string="Vendido (Confirmado)" name="filter_sold" domain="[('cotizacion_state', '=', 'confirmed'), ('option_selected', '=', True)]"/>
                <separator/>
                <filter string="Producto/Concepto" name="group_product" context="{'group_by':'name'}"/>
                <filter string="Vendedor" name="group_user" context="{'group_by':'user_id'}"/>
                <filter string="Cliente" name="group_partner" context="{'group_by':'partner_id'}"/>
                <filter string="Fecha" name="group_date" context="{'group_by':'date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_cotizacion_express_report" model="ir.actions.act_window">
        <field name="name">Resultados de Ventas</field>
        <field name="res_model">cotizacion.express.option.line</field>
        <field name="view_mode">graph,pivot</field>
        <field name="domain">[('cotizacion_state', '=', 'confirmed'), ('option_selected', '=', True)]</field>
        <field name="context">{'search_default_group_product': 1}</field>
    </record>

    <record id="action_cotizacion_express" model="ir.actions.act_window">
        <field name="name">Cotizaciones Express</field>
        <field name="res_model">cotizacion.express</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
    </record>

    <record id="action_cotizacion_express_stage" model="ir.actions.act_window">
        <field name="name">Etapas de Cotización</field>
        <field name="res_model">cotizacion.express.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENUS -->
    <menuitem id="menu_cotizaciones_list" name="Cotizaciones" parent="menu_cotizaciones_root" action="action_cotizacion_express" sequence="10"/>
    <menuitem id="menu_cotizacion_express_report" name="Resultados de Ventas" parent="menu_cotizaciones_root" action="action_cotizacion_express_report" sequence="20"/>
    <menuitem id="menu_cotizacion_express_stage" name="Etapas" parent="menu_cotizaciones_root" action="action_cotizacion_express_stage" sequence="40"/>

    <record id="action_cotizacion_express_tag" model="ir.actions.act_window">
        <field name="name">Etiquetas de Cotización</field>
        <field name="res_model">cotizacion.express.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cotizacion_express_tag" name="Etiquetas" parent="menu_cotizaciones_root" action="action_cotizacion_express_tag" sequence="45"/>
    <record id="view_cotizacion_confirm_wizard_form" model="ir.ui.view">
        <field name="name">cotizacion.confirm.wizard.form</field>
        <field name="model">cotizacion.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar Venta - Seleccionar Opciones">
                <field name="cotizacion_id" invisible="1"/>
                <p class="oe_grey">
                    Seleccione las opciones que el cliente decidió confirmar para esta cotización. Puede elegir varias:
                </p>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="false" delete="false">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="name" string="Opción"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="total" string="Monto"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" string="Confirmar Venta" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- VIEWS FOR TEMPLATES -->
    <record id="view_cotizacion_express_template_form" model="ir.ui.view">
        <field name="name">cotizacion.express.template.form</field>
        <field name="model">cotizacion.express.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de Cotización Express">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Nombre de la Plantilla..."/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Opciones / Paquetes" name="options">
                            <field name="option_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="discount_general"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                        </group>
                                        <group>
                                            <field name="discount_general"/>
                                        </group>
                                    </group>
                                    <notebook>
                                        <page string="Productos" name="lines">
                                            <field name="line_ids">
                                                <list>
                                                    <field name="name"/>
                                                    <field name="description" widget="html" options="{'style-inline': true}"/>
                                                    <field name="quantity"/>
                                                    <field name="price_unit"/>
                                                    <field name="discount"/>
                                                    <field name="iva_percent"/>
                                                </list>
                                            </field>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                        <page string="Términos y Condiciones" name="notes">
                            <field name="notes" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cotizacion_express_template_tree" model="ir.ui.view">
        <field name="name">cotizacion.express.template.tree</field>
        <field name="model">cotizacion.express.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_cotizacion_express_template" model="ir.actions.act_window">
        <field name="name">Plantillas de Cotización</field>
        <field name="res_model">cotizacion.express.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_cotizacion_express_template_option_form" model="ir.ui.view">
        <field name="name">cotizacion.express.template.option.form</field>
        <field name="model">cotizacion.express.template.option</field>
        <field name="arch" type="xml">
            <form string="Plantilla de Opción / Paquete">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Nombre de la Opción..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="discount_general"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos" name="lines">
                            <field name="line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="description" widget="html" options="{'style-inline': true}"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="discount"/>
                                    <field name="iva_percent"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cotizacion_express_template_option_tree" model="ir.ui.view">
        <field name="name">cotizacion.express.template.option.tree</field>
        <field name="model">cotizacion.express.template.option</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="template_id"/>
                <field name="discount_general"/>
            </list>
        </field>
    </record>

    <record id="action_cotizacion_express_template_option" model="ir.actions.act_window">
        <field name="name">Plantillas de Paquetes</field>
        <field name="res_model">cotizacion.express.template.option</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENUS FOR TEMPLATES -->
    <menuitem id="menu_cotizacion_express_template" name="Plantillas de Cotización" parent="menu_cotizaciones_root" action="action_cotizacion_express_template" sequence="25"/>
    <menuitem id="menu_cotizacion_express_template_option" name="Plantillas de Paquetes" parent="menu_cotizaciones_root" action="action_cotizacion_express_template_option" sequence="30"/>

    <!-- FORM VIEW FOR TEMPLATE LINE POP-UP MODAL -->
    <record id="view_cotizacion_express_template_option_line_form" model="ir.ui.view">
        <field name="name">cotizacion.express.template.option.line.form</field>
        <field name="model">cotizacion.express.template.option.line</field>
        <field name="arch" type="xml">
            <form string="Producto / Concepto de Plantilla">
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Producto"/>
                            <field name="quantity" string="Cantidad"/>
                            <field name="price_unit" string="Precio Unitario"/>
                        </group>
                        <group>
                            <field name="discount" string="Descuento %"/>
                            <field name="iva_percent" string="IVA %"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción" name="description_page">
                            <field name="description" widget="html" options="{'style-inline': true}" placeholder="Escriba la descripción del producto o servicio..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VIEWS AND CONFIGURATION FOR TAGS -->
    <record id="view_cotizacion_express_tag_list" model="ir.ui.view">
        <field name="name">cotizacion.express.tag.list</field>
        <field name="model">cotizacion.express.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_cotizacion_express_tag_form" model="ir.ui.view">
        <field name="name">cotizacion.express.tag.form</field>
        <field name="model">cotizacion.express.tag</field>
        <field name="arch" type="xml">
            <form string="Etiqueta de Cotización">
                <sheet>
                    <group>
                        <field name="name" string="Nombre de la Etiqueta"/>
                        <field name="color" widget="color_picker" string="Color de la Etiqueta"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
