<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión del Ticket de Helpdesk para agregar Licencias y Equipos -->
    <record id="helpdesk_ticket_view_form_inherit_licencias" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.licencias</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <!-- Insertar una pestaña dedicada en el notebook con campos agrupados -->
            <xpath expr="//notebook" position="inside">
                <page string="Licencia y Equipo" name="licencia_equipo_tab">
                    <group>
                        <group string="Datos de la Licencia">
                            <field name="sale_order_id" help="Venta de origen para precargar el cliente"/>
                            <field name="licencia_id" 
                                   domain="[('partner_id', '=', partner_id)]"
                                   options="{'no_create': True}"
                                   placeholder="Seleccione la licencia..."/>
                        </group>
                        <group string="Datos del Equipo/Terminal" invisible="not licencia_id">
                            <field name="equipo_id" 
                                   domain="[('licencia_id', '=', licencia_id)]"
                                   options="{'no_create': True}"
                                   placeholder="Seleccione el equipo/terminal..."/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
