<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_licencia" model="ir.ui.view">
        <name>res.partner.form.inherit.licencia</name>
        <model>res.partner</model>
        <inherit_id ref="base.view_partner_form"/>
        <arch type="xml">
            <!-- Smart Button for Licenses -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_licencias" icon="fa-key" attrs="{'invisible': [('is_company', '=', False), ('parent_id', '!=', False)]}">
                    <field string="Licencias" name="licencia_count" widget="statinfo"/>
                </button>
            </xpath>

            <!-- Notebook Tab for Licenses and Equipment -->
            <xpath expr="//notebook" position="inside">
                <page string="Licencias y Equipos" name="licencias_equipos" attrs="{'invisible': [('is_company', '=', False), ('parent_id', '!=', False)]}">
                    <group string="Resumen de Licencias Activas">
                        <field name="licencia_ids" nolabel="1" mode="tree">
                            <tree create="true" edit="true" delete="true">
                                <field name="software_type"/>
                                <field name="name"/>
                                <field name="adquisicion_date"/>
                                <field name="expiracion_date"/>
                                <field name="status" widget="badge" decoration-success="status == 'activo'" decoration-danger="status == 'vencido'" decoration-warning="status == 'suspendido'"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </arch>
    </record>
</odoo>
