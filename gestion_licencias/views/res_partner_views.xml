<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_licencias_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.licencias.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            
            <!-- 1. Insertar el BOTÓN inteligente arriba a la derecha -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_licencias" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-id-card-o" 
                        invisible="licencia_count == 0">
                    <field name="licencia_count" widget="statinfo" string="Licencias"/>
                </button>
            </xpath>

            <!-- 2. Insertar la PESTAÑA de licencias en el cuerpo del formulario -->
            <xpath expr="//notebook" position="inside">
                <page string="Licencias y Equipos" name="licencias_contpaqi">
                    <group string="Licencias Contpaqi">
                        <field name="licencia_ids" nolabel="1">
                            <list>
                                <field name="name" string="Serie"/>
                                <field name="software_type"/>
                                <field name="fecha_vencimiento"/>
                                <field name="state" widget="badge" decoration-success="state == 'renovada'" decoration-info="state == 'activa'" decoration-danger="state == 'cancelada'"/>
                            </list>
                        </field>
                    </group>
                    <group string="Equipos Instalados">
                        <field name="partner_equipo_ids" nolabel="1">
                            <list edit="false" create="false" delete="false">
                                <field name="nombre_equipo"/>
                                <field name="tipo"/>
                                <field name="caracteristicas"/>
                                <field name="licencia_id" string="Licencia"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
            
        </field>
    </record>
</odoo>
