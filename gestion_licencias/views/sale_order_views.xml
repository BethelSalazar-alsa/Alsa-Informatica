<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_licencia_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.licencia.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- 1. Insertar el botón inteligente en la caja de botones (button_box) -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_licencias_creadas" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-id-card-o" 
                        invisible="licencia_count == 0">
                    <field name="licencia_count" widget="statinfo" string="Licencias Creadas"/>
                </button>
            </xpath>
            
            <!-- 2. Agregar botón rápido en el header -->
            <xpath expr="//button[@name='action_quotation_send']" position="before">
                <button name="action_crear_licencia_rapida" string="📋 Registrar Licencia Rápida" 
                    type="object" class="btn-info" />
            </xpath>
        </field>
    </record>
</odoo>
