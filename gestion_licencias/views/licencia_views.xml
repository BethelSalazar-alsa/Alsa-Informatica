<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista de Equipos -->
    <record id="view_licencia_linea_list" model="ir.ui.view">
        <field name="name">licencia.linea.list</field>
        <field name="model">licencia.linea</field>
        <field name="arch" type="xml">
            <list string="Equipos Instalados">
                <field name="nombre_equipo"/>
                <field name="tipo"/>
                <field name="caracteristicas"/>
                <field name="licencia_id"/>
            </list>
        </field>
    </record>

    <!-- Vista Lista de Licencias -->
    <record id="view_licencia_contpaqi_list" model="ir.ui.view">
        <field name="name">licencia.contpaqi.list</field>
        <field name="model">licencia.contpaqi</field>
        <field name="arch" type="xml">
            <list decoration-danger="fecha_vencimiento &lt; current_date">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="fecha_vencimiento"/>
                <field name="state" widget="badge" decoration-success="state == 'renovada'" decoration-info="state == 'activa'" decoration-danger="state == 'cancelada'"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario de Licencias -->
    <record id="view_licencia_contpaqi_form" model="ir.ui.view">
        <field name="name">licencia.contpaqi.form</field>
        <field name="model">licencia.contpaqi</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_renovada" string="Marcar como Renovada" type="object" class="oe_highlight" invisible="state != 'activa'"/>
                    <button name="action_set_cancelada" string="Cancelar Licencia" type="object" invisible="state != 'activa'"/>
                    <field name="state" widget="statusbar" statusbar_visible="activa,renovada,cancelada"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Número de Serie / Licencia"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="vendedor_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="fecha_vencimiento"/>
                            <field name="software_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipos" name="equipos">
                            <field name="linea_ids">
                                <list editable="bottom">
                                    <field name="nombre_equipo"/>
                                    <field name="tipo"/>
                                    <field name="caracteristicas"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Buscador -->
    <record id="view_licencia_contpaqi_search" model="ir.ui.view">
        <field name="name">licencia.contpaqi.search</field>
        <field name="model">licencia.contpaqi</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Serie o Licencia"/>
                <field name="partner_id" string="Cliente"/>
                <filter string="Activas" name="filter_active" domain="[('state', '=', 'activa')]"/>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_licencia_contpaqi" model="ir.actions.act_window">
        <field name="name">Licencias Contpaqi</field>
        <field name="res_model">licencia.contpaqi</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menús -->
    <menuitem id="menu_licencias_root" name="Licencias" sequence="10"/>
    <menuitem id="menu_licencias_contpaqi_list" name="Todas las Licencias" parent="menu_licencias_root" action="action_licencia_contpaqi" sequence="10"/>
</odoo>
