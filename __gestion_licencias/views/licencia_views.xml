<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_licencia_licencia_tree" model="ir.ui.view">
        <name>licencia.licencia.tree</name>
        <model>licencia.licencia</model>
        <arch type="xml">
            <tree decoration-danger="status == 'vencido'" decoration-warning="status == 'suspendido'" decoration-success="status == 'activo'">
                <field name="name"/>
                <field name="software_type"/>
                <field name="partner_id"/>
                <field name="adquisicion_date"/>
                <field name="expiracion_date"/>
                <field name="status" widget="badge" decoration-success="status == 'activo'" decoration-danger="status == 'vencido'" decoration-warning="status == 'suspendido'"/>
            </tree>
        </arch>
    </record>

    <!-- Form View -->
    <record id="view_licencia_licencia_form" model="ir.ui.view">
        <name>licencia.licencia.form</name>
        <model>licencia.licencia</model>
        <arch type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="activo,vencido,suspendido" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Clave o Serie de la Licencia..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="software_type"/>
                            <field name="partner_id" context="{'res_partner_search_mode': 'customer'}"/>
                        </group>
                        <group>
                            <field name="adquisicion_date"/>
                            <field name="expiracion_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipos Vinculados" name="equipos">
                            <field name="equipo_ids" mode="tree">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="tipo"/>
                                    <field name="ip_address"/>
                                    <field name="usuario_responsable"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notas de Configuración" name="notes">
                            <field name="notes" placeholder="Detalles de instalación, credenciales del servidor, configuraciones de red, etc."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </arch>
    </record>

    <!-- Search View -->
    <record id="view_licencia_licencia_search" model="ir.ui.view">
        <name>licencia.licencia.search</name>
        <model>licencia.licencia</model>
        <arch type="xml">
            <search>
                <field name="name" string="Clave/Serie"/>
                <field name="partner_id" string="Cliente"/>
                <field name="software_type"/>
                <filter string="Activo" name="status_activo" domain="[('status', '=', 'activo')]"/>
                <filter string="Vencido" name="status_vencido" domain="[('status', '=', 'vencido')]"/>
                <filter string="Suspendido" name="status_suspendido" domain="[('status', '=', 'suspendido')]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Cliente" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Software" name="group_by_software" context="{'group_by': 'software_type'}"/>
                    <filter string="Estado" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </arch>
    </record>

    <!-- Action -->
    <record id="action_licencia_licencia" model="ir.actions.act_window">
        <name>Licencias Contpaqi</name>
        <res_model>licencia.licencia</res_model>
        <view_mode>tree,form</view_mode>
        <search_view_id ref="view_licencia_licencia_search"/>
        <help type="html">
            <p class="o_view_nocontent_smiling_face">
                Registra la primera licencia de software Contpaqi.
            </p>
            <p>
                Asocia la licencia a un cliente y agrega los equipos correspondientes (Servidores y Terminales).
            </p>
        </help>
    </record>
</odoo>
